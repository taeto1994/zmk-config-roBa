// ★スクロールの移動量（この数字を大きくするとスクロールが速くなるよ）

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <input/processors.dtsi> // ★追加：トラックボールをスクロールにするための設定
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// ★追加：トラックボールの振動対策（誤爆防止の強化版！）

&lt {
    flavor = "tap-preferred";
    require-prior-idle-ms = <400>;
    tapping-term-ms = <400>;  // タイピング中のもたつきを感じたら 280 などに下げてみてね
    quick-tap-ms = <200>;
};

&trackball {
};

/ {
    // ★追加：NUMレイヤー(Layer 2)の時だけ、トラックボールをスクロールにする設定

    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        scroll_layer {
            layers = <2>;
            input-processors =
                <&zip_xy_to_scroll_mapper>,
                <&zip_scroll_scaler (-1) 3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <1 0>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 11>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        new_taeto: new_taeto {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Y) &kp A &kp M &kp A &kp G &kp A &kp K &kp U &kp N7 &kp N2 &kp N5 &kp N0>;
            label = "NEW_TAETO";
        };

        new_taeto2: new_taeto2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp T &kp A &kp A &kp K &kp I &kp A &kp T &kp U &kp O &kp E &kp N8>;
            label = "NEW_TAETO2";
        };

        alt_tab: alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT &kp TAB>;
            label = "ALT_TAB";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // ★維持：ロータリーエンコーダー（ホイール）をマウススクロールにする設定

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W                      &kp E         &kp R                 &kp T                                              &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A  &kp S                      &kp D         &kp F                 &kp G        &kp ESCAPE              &kp LS(INT1)  &kp H          &kp J  &kp K      &kp L    &kp SQT
&kp Z  &kp X                      &kp C         &kp V                 &kp B        &lt 6 LEFT_BRACKET      &kp MINUS     &kp N          &kp M  &kp COMMA  &kp DOT  &kp SLASH
&none  &mt LEFT_CONTROL LEFT_WIN  &kp LEFT_ALT  &mt LEFT_SHIFT GRAVE  &lt 2 SPACE  &lt 3 SPACE             &lt 1 ENTER   &kp BACKSPACE                             &kp DEL
            >;

            // ↑ 左下が LCTRL じゃなく「&none」になっているのが誤爆防止のポイント！

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        FUNCTION {
            bindings = <
&new_taeto  &new_taeto2  &alt_tab  &trans         &kp PRINTSCREEN                                     &kp STAR  &kp LPAR  &trans  &trans  &trans
&trans      &trans       &trans    &trans         &kp AT            &kp PERCENT      &kp KP_MULTIPLY  &trans    &trans    &trans  &trans  &trans
&trans      &trans       &trans    &trans         &kp HASH          &kp CARET        &kp DOLLAR       &trans    &trans    &trans  &trans  &trans
&trans      &trans       &trans    &kp C_AC_BACK  &kp C_AC_FORWARD  &kp PERCENT      &trans           &trans                              &trans
            >;

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        NUM {
            bindings = <
&trans  &trans  &trans  &trans  &trans                              &kp CARET         &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0
&trans  &trans  &trans  &trans  &trans  &trans      &kp UNDERSCORE  &kp EXCLAMATION   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp COLON       &kp LEFT_BRACKET  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans                                                               &trans
            >;

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans  &kp CAPS                      &trans          &kp UP_ARROW    &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans      &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans          &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans                                                   &trans
            >;

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };
    };
};
