// ★スクロールの移動量

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    flavor = "tap-preferred";
    require-prior-idle-ms = <200>; // 振動対策も維持
    tapping-term-ms = <250>;
    quick-tap-ms = <300>;
};

&trackball {
};

/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        // トラックボールを動かした時に、自動でMOUSEレイヤーを有効化
        // MOUSEレイヤーは Layer 4
        input-processors = <&zip_temp_layer 4 700>;

        scroll_layer {
            layers = <5>;
            input-processors =
                <&zip_xy_to_scroll_mapper>,
                <&zip_scroll_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
                <&zip_scroll_scaler 1 7>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        new_taeto: new_taeto {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(Y) &kp A &kp M &kp A &kp G &kp A &kp K &kp U &kp N7 &kp N2 &kp N5 &kp N0>;
            label = "NEW_TAETO";
        };

        new_taeto2: new_taeto2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp T &kp A &kp A &kp K &kp I &kp A &kp T &kp U &kp O &kp E &kp N8>;
            label = "NEW_TAETO2";
        };

        kakko: kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp STAR &kp LPAR>;
            label = "KAKKO";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q       &kp W                      &kp E         &kp R                 &kp T                                              &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A       &kp S                      &kp D         &kp F                 &kp G        &lt 5 CARET             &kp LS(INT1)  &kp H          &kp J  &kp K      &kp L    &kp SQT
&kp Z       &kp X                      &kp C         &kp V                 &kp B        &lt 6 LEFT_BRACKET      &kp MINUS     &kp N          &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp ESCAPE  &mt LEFT_CONTROL LEFT_WIN  &kp LEFT_ALT  &mt LEFT_SHIFT GRAVE  &lt 2 SPACE  &lt 3 ENTER             &lt 1 ENTER   &kp BACKSPACE                             &kp DEL
            >;

            // ★右親指を「&lt 5 SPACE」に変更！ここを押している間だけスクロールになります。

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        FUNCTION {
            bindings = <
&new_taeto  &new_taeto2  &kp TAB  &trans        &kp PRINTSCREEN                                         &kakko  &kp LA(TAB)  &trans  &trans  &trans
&trans      &trans       &trans   &trans        &trans           &kp LS(LC(NUMBER_9))      &kp PERCENT  &trans  &trans       &trans  &trans  &trans
&trans      &trans       &trans   &trans        &kp HASH         &kp CARET                 &trans       &trans  &trans       &trans  &trans  &trans
&trans      &trans       &trans   &kp LA(LEFT)  &kp LA(RIGHT)    &kp LC(ENTER)             &trans       &trans                               &trans
            >;

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        NUM {
            bindings = <
&kp F1  &kp F2  &trans  &kp LG(D)  &kp LC(C)                                   &kp CARET        &kp N7  &kp N8  &kp N9  &kp N0
&trans  &trans  &trans  &kp LG(H)  &kp LC(V)  &kp DOLLAR      &kp UNDERSCORE   &kp EXCLAMATION  &kp N4  &kp N5  &kp N6  &trans
&trans  &trans  &trans  &trans     &trans     &kp HASH        &kp COLON        &kp AT           &kp N1  &kp N2  &kp N3  &trans
&trans  &trans  &trans  &trans     &trans     &trans          &kp KP_MULTIPLY  &trans                                   &trans
            >;

            // ここでの数字入力中にボールが揺れても、もうスクロールしません！

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans          &kp CAPS                                                   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans          &kp UP_ARROW    &trans               &kp LS(LC(UP_ARROW))  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp LS(LC(DOWN))      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans          &trans          &trans               &trans                &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &mkp MB1  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                              &trans
            >;

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            // このレイヤー（Layer 5）にいる時だけ、ボールがホイールとして動きます！

            sensor-bindings = <&scroll_up_down>;
        };

        layer_6 {
            bindings = <
&bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0                             &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &bt BT_CLR      &trans           &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &bootloader      &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans          &trans           &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down &scroll_up_down>;
        };
    };
};
